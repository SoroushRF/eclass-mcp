ECLASS_URL=https://eclass.yorku.ca
AUTH_PORT=3000
CACHE_DIR=.eclass-mcp/cache
SESSION_FILE=.eclass-mcp/session.json

# Required: passphrase used to encrypt local auth session files.
# Use a long unique value; changing it invalidates saved eClass/Cengage sessions.
# ECLASS_MCP_SESSION_SECRET=change-me-to-a-long-random-secret-at-least-32-chars

# Optional: how long eClass/SIS tools wait for re-auth before returning auth_required (default 120000 = 2 minutes)
# ECLASS_MCP_AUTH_WAIT_MS=120000

# Optional: eClass data source mode. Playwright is the safe default; shadow compares
# API results without changing the user-visible Playwright result; api enables the
# bounded API-first path with Playwright fallback for supported reads.
# ECLASS_API_SOURCE_MODE=playwright

# Optional: timeout for authenticated eClass API requests (default 15000 ms; max 60000).
# API requests use the saved browser session and an in-memory sesskey. Do not add
# sesskeys, mobile tokens, or other credentials to environment files.
# ECLASS_API_TIMEOUT_MS=15000

# Optional and disabled by default: allow authenticated HTML debug snapshots.
# Enable only for local, account-owner debugging; snapshots can contain course data.
# ECLASS_MCP_ALLOW_AUTH_DEBUG_DUMPS=false

# Optional: max total bytes for user-pinned cache entries (default 314572800 = 300 MiB)
# ECLASS_MCP_PIN_QUOTA_BYTES=314572800
