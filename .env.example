ECLASS_URL=https://eclass.yorku.ca
AUTH_PORT=3000
CACHE_DIR=.eclass-mcp/cache
SESSION_FILE=.eclass-mcp/session.json

# Optional: how long eClass/SIS tools wait for re-auth before returning auth_required (default 120000 = 2 minutes)
# ECLASS_MCP_AUTH_WAIT_MS=120000

# Optional: max total bytes for user-pinned cache entries (default 314572800 = 300 MiB)
# ECLASS_MCP_PIN_QUOTA_BYTES=314572800
